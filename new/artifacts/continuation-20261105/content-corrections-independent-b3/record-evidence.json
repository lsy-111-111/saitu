          "id": "national-college-electronic-design:v2:eligibility",
          "text": "2025普通高校正式学籍全日制本科、高职高专学生三人组队，由学校报名。本科生只能选本科题；高职高专学生也可选本科题。三人均须全程参赛和评审。",
          "entity": {
            "editionId": "2025-national",
            "trackId": "monocular-measurement",
            "groupId": "undergraduate-task",
            "scopeId": "china-2025-c"
          },
